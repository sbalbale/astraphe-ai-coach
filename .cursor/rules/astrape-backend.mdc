## Router Pattern

```python
# routers/workouts.py
router = APIRouter(prefix="/workouts", tags=["workouts"])

@router.post("", response_model=WorkoutResponse, status_code=201)
async def ingest_workout(
    payload: WorkoutPayload,
    athlete: dict = Depends(get_current_athlete),
    db = Depends(get_db)
):
    tss = _compute_tss(payload, athlete)
    row = payload.model_dump() | {"athlete_id": athlete["id"], "tss": tss}
    result = await db.table("workouts").insert(row).execute()
    await _recompute_athlete_load(athlete["id"], db)
    return WorkoutResponse(**result.data[0])
```

