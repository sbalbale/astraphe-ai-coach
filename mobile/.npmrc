# pnpm security hardening — Astraphe AI (mobile app)
# Block all lifecycle scripts by default; allowlist per-package as needed.
enable-pre-post-scripts=false

# Require packages to be at least 1 day old before installing.
# Protects against zero-day supply chain attacks (e.g. Axios/Shai-Hulud style).
minimum-release-age=1440

# Trust-downgrade blocking can reject valid transitive deps (e.g. missing provenance on newer publishes).
# Re-enable when compatible with your tree: trust-policy=no-downgrade

# Use a local store inside the project to keep CI reproducible.
# Remove this line if you prefer the global pnpm store (fine for local dev).
# store-dir=.pnpm-store
