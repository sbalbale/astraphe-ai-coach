{
	"name": "mobile",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"preinstall": "node scripts/check-package-manager.mjs",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run"
	},
	"engines": {
		"node": ">=20.0.0",
		"pnpm": ">=10.0.0",
		"npm": "please-use-pnpm"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"devDependencies": {
		"@capacitor/cli": "8.3.1",
		"@sveltejs/adapter-auto": "7.0.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.58.0",
		"@sveltejs/vite-plugin-svelte": "7.0.0",
		"@tailwindcss/typography": "0.5.19",
		"@types/d3": "7.4.3",
		"@types/node": "^22.19.1",
		"autoprefixer": "10.5.0",
		"postcss": "8.5.12",
		"svelte": "5.55.5",
		"svelte-check": "4.4.6",
		"tailwindcss": "3.4.19",
		"typescript": "6.0.3",
		"vite": "8.0.10",
		"vitest": "3.2.4"
	},
	"dependencies": {
		"@capacitor/app": "8.1.0",
		"@capacitor/background-runner": "3.0.0",
		"@capacitor/browser": "8.0.3",
		"@capacitor/core": "8.3.1",
		"@capacitor/ios": "8.3.1",
		"@capacitor/preferences": "8.0.1",
		"@iconify/svelte": "5.2.1",
		"@interval-health/capacitor-health": "2.0.0",
		"@supabase/supabase-js": "2.105.0",
		"d3": "7.9.0",
		"date-fns": "4.1.0",
		"dompurify": "3.4.1",
		"katex": "0.16.45",
		"layerchart": "1.0.13",
		"lucide-svelte": "1.0.1",
		"maplibre-gl": "5.24.0",
		"marked": "16.4.2",
		"marked-katex-extension": "5.1.8"
	}
}
