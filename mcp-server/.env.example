APP_ENV="development"
PORT=8090

# Same Supabase project as backend/.env — RLS scopes every call by the caller's own token,
# so this server never needs the service-role key.
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_KEY="your-anon-public-key-here"

# Supabase Auth (GoTrue) acting as the OAuth 2.1 authorization server. issuer_url must match
# GoTrue's own issuer exactly — check /auth/v1/.well-known/oauth-authorization-server's
# "issuer" field. See docs/MCP_SERVER.md for enabling [auth.oauth_server] in supabase/config.toml.
MCP_ISSUER_URL="http://127.0.0.1:54321/auth/v1"
# The public URL this server itself is reachable at (RFC 8707 resource indicator).
MCP_RESOURCE_URL="http://127.0.0.1:8090"

# Dynamic client registration — any MCP client can self-register without a manually-issued
# client ID/secret when this is on (see docs/MCP_SERVER.md). Requires
# supabase/config.toml's allow_dynamic_registration too.
MCP_ALLOW_DYNAMIC_CLIENT_REGISTRATION="false"

# Max MCP tool calls per user per minute (backend/app/core/rate_limiter.py, reused
# unmodified). Uses backend's own REDIS_URL (set that in backend/.env, not here) for
# shared state across replicas — falls back to this process's in-memory state otherwise.
MCP_RATE_LIMIT_RPM=30
