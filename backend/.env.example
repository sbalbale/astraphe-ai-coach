# App Configuration
APP_NAME="ASTRAPE AI Coach"
APP_ENV="development"
PORT=8000
APP_BASE_URL="http://localhost:8000"
API_PREFIX="/v1"
MOBILE_DEEP_LINK_SCHEME="astrape"

# Supabase Database Credentials
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-anon-public-key-here"

# Google Gemini AI Credentials
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-pro"

# Google Cloud Settings
GCP_PROJECT_ID="your-google-cloud-project-id"
GCP_BUCKET_NAME="astrape-workout-files-bucket"

# WHOOP Integration
WHOOP_CLIENT_ID="your_whoop_client_id"
WHOOP_CLIENT_SECRET="your_whoop_client_secret"
WHOOP_WEBHOOK_SECRET="your_whoop_webhook_secret"
WHOOP_API_BASE="https://api.prod.whoop.com/developer/v1"
WHOOP_OAUTH_AUTH_URL="https://api.prod.whoop.com/oauth/oauth2/auth"
WHOOP_OAUTH_TOKEN_URL="https://api.prod.whoop.com/oauth/oauth2/token"

# Garmin Integration
GARMIN_CONSUMER_KEY="your_garmin_consumer_key"
GARMIN_CONSUMER_SECRET="your_garmin_consumer_secret"
GARMIN_WEBHOOK_SECRET="your_garmin_webhook_secret"
GARMIN_OAUTH_CONFIRM_URL="https://connect.garmin.com/oauthConfirm"