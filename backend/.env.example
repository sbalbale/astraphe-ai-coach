# App Configuration
APP_NAME="ASTRAPE AI Coach"
APP_ENV="development"
PORT=8000

# Supabase Database Credentials
# You can find these in Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-anon-public-key-here"

# Google Gemini AI Credentials
# Generate this at https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-pro" # You can choose other models like "gemini-2.5-pro", "gemini-3.0-pro", etc.