# App Configuration
APP_NAME="ASTRAPHE AI Coach"
APP_ENV="development"
PORT=8000
APP_BASE_URL="http://localhost:8000"
API_PREFIX="/v1"
MOBILE_DEEP_LINK_SCHEME="astraphe"

# Supabase Database Credentials
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-anon-public-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
# Optional: direct Postgres URL for local CLI/migrations (e.g. Supabase local port 54322)
SUPABASE_DB_URL="postgresql://postgres:postgres@your-supabase-url/postgres"

# Google Gemini AI Credentials
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemma-4-31b-it"
GEMINI_FALLBACK_MODEL="gemma-4-26b-a4b-it"
GEMINI_ANALYSIS_MODEL="gemini-flash-lite-latest"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"

# Google Cloud Settings
GCP_PROJECT_ID="your-google-cloud-project-id"
GCP_BUCKET_NAME="astraphe-workout-files-bucket"

# WHOOP Integration
WHOOP_CLIENT_ID="your_whoop_client_id"
WHOOP_CLIENT_SECRET="your_whoop_client_secret"
# Optional duplicate of WHOOP_CLIENT_SECRET for webhook HMAC verification.
# WHOOP signs webhooks with the OAuth client secret — there is no separate portal secret.
# If unset, WHOOP_CLIENT_SECRET is used automatically.
WHOOP_WEBHOOK_SECRET="your_whoop_client_secret"
WHOOP_API_BASE="https://api.prod.whoop.com/developer/v1"
WHOOP_OAUTH_AUTH_URL="https://api.prod.whoop.com/oauth/oauth2/auth"
WHOOP_OAUTH_TOKEN_URL="https://api.prod.whoop.com/oauth/oauth2/token"

# Garmin Integration
# CONSUMER_KEY/SECRET/OAUTH_CONFIRM_URL are dormant — kept for a possible future
# official Garmin Connect Developer Program integration. The active integration
# uses the athlete's own Garmin username/password (no client id/secret needed).
GARMIN_CONSUMER_KEY="your_garmin_consumer_key"
GARMIN_CONSUMER_SECRET="your_garmin_consumer_secret"
GARMIN_WEBHOOK_SECRET="your_garmin_webhook_secret"
GARMIN_OAUTH_CONFIRM_URL="https://connect.garmin.com/oauthConfirm"
GARMIN_SYNC_POLL_HOURS=1

# OAuth token encryption at rest (WHOOP, Strava, intervals.icu, and Garmin
# oauth_tokens.access_token / refresh_token — required in production).
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_TOKEN_ENCRYPTION_KEY=""

# Intervals.icu Integration
INTERVALS_ICU_API_BASE="https://intervals.icu/api"
INTERVALS_ICU_AUTH_MODE="basic"

# Resend Email / Marketing
# Get your API key from resend.com/api-keys
# Get the segment ID from resend.com/contacts (Segments tab → "Astraphe Marketing" → copy UUID from URL)
RESEND_API_KEY="re_your_api_key_here"
RESEND_AUDIENCE_ID="your_segment_uuid_here"

# Strava Integration
STRAVA_CLIENT_ID="your_strava_client_id"
STRAVA_CLIENT_SECRET="your_strava_client_secret"
STRAVA_WEBHOOK_VERIFY_TOKEN="your_chosen_verify_token"
STRAVA_WEBHOOK_SUBSCRIPTION_ID=0

# Redis
# Local dev (requires: docker compose up -d redis):
REDIS_URL="redis://127.0.0.1:6379"
# Production (Proxmox docker compose, same network as astraphe-api):
# REDIS_URL="redis://astraphe-redis:6379"

# Push Notifications
# VAPID keys for web push — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
VAPID_SUBJECT="mailto:your@email.com"
# Firebase service account JSON (single-line) — for iOS/Android native push
# FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
