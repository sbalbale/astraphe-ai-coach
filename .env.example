# ==========================================
# ASTRAPHE AI Coach — Root Environment
# ==========================================
# This file is a quick-reference overview only. Each service reads its own
# .env file — copy the real ones and fill them in:
#
#   cp backend/.env.example backend/.env
#   cp mobile/.env.example  mobile/.env
#
# See docs/SETUP.md for the full local development walkthrough, including
# how to get Supabase local keys via `npx supabase status`.

# ─── Supabase (local via `npx supabase start`, or your own project) ───
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── Google Gemini AI (see backend/.env.example for all model vars) ───
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Redis (optional for local dev — `docker compose up -d redis`) ───
REDIS_URL=redis://127.0.0.1:6379

# ─── Mobile / Frontend (see mobile/.env.example) ───
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_KEY=your-anon-public-key-here
VITE_API_URL=http://localhost:8000

# ─── Push Notifications (web push — generate with `npx web-push generate-vapid-keys`) ───
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com
